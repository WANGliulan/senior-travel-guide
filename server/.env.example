# ============================================================
# 智游康行·岁旅相伴 —— 后端环境变量模板
# 使用方式：复制本文件为 server/.env 后填写（或在云平台「环境变量」中配置）
#           代码中绝不出现任何明文 Key，全部通过环境变量注入。
# ============================================================

# ---------- 服务 ----------
PORT=3000
HOST=0.0.0.0
# 允许跨域的来源，* 表示全部（公网评审建议保持 *）
CORS_ORIGIN=*

# ---------- ★ 大模型 API（当前留空，拿到 Key 后填这里即可启用）----------
# 厂商预设：ark(火山方舟豆包) / dashscope(通义千问) / openai / deepseek / moonshot(Kimi) / zhipu(GLM) / custom
#   ark        → https://ark.cn-beijing.volces.com/api/v3  （Responses 协议，豆包）
#   dashscope  → https://dashscope.aliyuncs.com/compatible-mode/v1 （OpenAI 兼容，通义千问）
LLM_PROVIDER=ark

# ★★★ 你的大模型 API Key —— 目前留空，未配置时后端自动走「规则引擎 + 知识库」兜底，
#     全流程功能完整、演示不中断；配置后行程生成与多轮对话由大模型产出。
#     火山方舟 Key 形如 ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx
LLM_API_KEY=

# 协议：auto(跟随厂商预设) / chat(OpenAI 兼容 /chat/completions) / responses(新版 /responses)
#   豆包默认走 responses；若换成不支持 /responses 的模型，改为 chat 即可
LLM_PROTOCOL=auto

# 模型名或推理接入点 ID（方舟可填 doubao-seed-evolving 或 ep-2024xxxx-xxxxx）
# 留空则使用厂商预设默认模型
LLM_MODEL=

# 接口地址，留空则使用厂商预设（私有化部署/本地 vLLM 时填写）
LLM_BASE_URL=

# 输出额度与超时：⚠️ 豆包 doubao-seed-evolving 是推理模型，思维链会占用输出额度
#   （实测一次简单问答就消耗约 1170 reasoning tokens），额度太小会「只思考不回答」。
#   ark 预设已默认给到 maxTokens=16384 / timeout=120000，一般无需修改。
LLM_TIMEOUT=
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=

# ★ 思维链开关（仅 responses 协议生效）：disabled / enabled / off(不发送该参数)
#   实测 disabled 可把一次行程生成从约 100 秒降到约 4 秒，强烈建议保持 disabled；
#   若换成不支持 thinking 参数的模型，设为 off 即可。
LLM_THINKING=

# ---------- 可选：简单鉴权（留空则开放访问，方便大赛公网评审）----------
ACCESS_TOKEN=

# ---------- 可选：数据与知识库 ----------
# 方案持久化目录（默认 server/data）
DATA_DIR=
# 知识库位置（默认自动复用 cloudfunctions/_shared/data.js）
KNOWLEDGE_PATH=

# ---------- 调试 ----------
DEBUG=0
