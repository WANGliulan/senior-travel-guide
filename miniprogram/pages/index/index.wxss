.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.hero {
  background: #E9F4EE;
  padding: 40rpx 44rpx 32rpx;
  color: #2E6B4F;
}
.hero-title { font-size: 1.4em; font-weight: 800; }
.hero-sub { margin-top: 8rpx; font-size: 0.82em; color: #7C8B83; }

.section-title { font-size: 1em; font-weight: 700; color: #2E6B4F; margin: 22rpx 32rpx 10rpx; }

/* 快捷服务模块（简约） */
.service-board {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx;
}
.service-card {
  width: 48%;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 2rpx solid #E3EFE8;
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
}
.service-card:active { background: #E9F4EE; }
.service-label { font-size: 1.05em; font-weight: 800; color: #2E6B4F; }
.service-desc { font-size: 0.78em; color: #7C8B83; margin-top: 6rpx; }

/* 对话区 */
.chat-area { flex: 1; padding: 0 24rpx 12rpx; box-sizing: border-box; }
.msg { display: flex; margin-bottom: 20rpx; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }
.msg-bubble {
  max-width: 82%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 0.95em;
  line-height: 1.55;
  word-break: break-all;
}
.msg-user .msg-bubble { background: #5DAF8C; color: #FFFFFF; border-top-right-radius: 4rpx; }
.msg-ai .msg-bubble { background: #FFFFFF; color: #2B3440; border-top-left-radius: 4rpx; border: 2rpx solid #E3EFE8; }
.msg-actions { margin-top: 14rpx; }
.msg-action {
  display: inline-block;
  padding: 14rpx 26rpx;
  background: #E9F4EE;
  color: #2E6B4F;
  border-radius: 40rpx;
  font-size: 0.9em;
  font-weight: 700;
}
.msg-action:active { background: #CFE0D4; }

/* 快捷指令条 */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 24rpx 12rpx;
}
.quick-chip {
  padding: 12rpx 24rpx;
  background: #E9F4EE;
  color: #2E6B4F;
  border-radius: 40rpx;
  font-size: 0.9em;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #E3EFE8;
}
.input {
  flex: 1;
  height: 88rpx;
  background: #EDF5F0;
  border-radius: 44rpx;
  padding: 0 30rpx;
  font-size: 1em;
}
.send-btn {
  margin-left: 18rpx;
  padding: 18rpx 36rpx;
  background: #5DAF8C;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 1em;
  font-weight: 700;
}
.send-btn.disabled { opacity: 0.6; }
