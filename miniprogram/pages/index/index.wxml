<view class="page {{highContrast ? 'high-contrast' : ''}}" style="font-size: {{fontScale}}px;">
  <!-- 顶部标题 -->
  <view class="hero">
    <view class="hero-title">智游康行 · 岁旅相伴</view>
    <view class="hero-sub">适老出行智能助手 · 自由对话 · 定制慢节奏行程</view>
  </view>

  <!-- 快捷服务模块 -->
  <view class="section-title">快捷服务</view>
  <view class="service-board">
    <view class="service-card" wx:for="{{quickServices}}" wx:key="key" data-key="{{item.key}}" bindtap="onService">
      <view class="service-label">{{item.label}}</view>
      <view class="service-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 智能体对话区 -->
  <view class="section-title">智能助手</view>
  <scroll-view scroll-y class="chat-area" scroll-into-view="{{scrollTo}}">
    <view class="msg {{m.role === 'user' ? 'msg-user' : 'msg-ai'}}" wx:for="{{messages}}" wx:key="id" id="msg-{{m.id}}">
      <view class="msg-bubble">
        <block wx:if="{{m.typing}}">正在思考…</block>
        <block wx:else>
          <text user-select>{{m.content}}</text>
          <view class="msg-actions" wx:if="{{m.actions.length > 0}}">
            <view class="msg-action" wx:for="{{m.actions}}" wx:key="label" data-city="{{item.city}}" bindtap="onMsgAction">{{item.label}}</view>
          </view>
        </block>
      </view>
    </view>
    <view id="bottom" style="height: 4rpx;"></view>
  </scroll-view>

  <!-- 快捷指令条 -->
  <view class="quick-row">
    <view class="quick-chip" wx:for="{{quickChips}}" wx:key="*this" data-text="{{item}}" bindtap="onQuick">{{item}}</view>
  </view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input class="input" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" placeholder="说点什么，比如：去北京玩3天" />
    <view class="send-btn {{sending ? 'disabled' : ''}}" bindtap="send">{{sending ? '…' : '发送'}}</view>
  </view>
</view>
