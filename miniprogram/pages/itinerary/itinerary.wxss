.page { padding-bottom: 60rpx; }
.overview {
  background: #5DAF8C;
  color: #FFFFFF; padding: 40rpx;
}
.ov-title { font-size: 1.35em; font-weight: 800; }
.ov-meta { margin-top: 12rpx; font-size: 0.95em; opacity: 0.92; }
.ov-risk { margin-top: 16rpx; font-size: 0.95em; }
.risk-low { color: #D9F2E3; font-weight: 800; }
.risk-mid { color: #FDE68A; font-weight: 800; }
.risk-high { color: #FCA5A5; font-weight: 800; }
.day-card { padding: 28rpx 32rpx; }
.day-head { font-size: 1.1em; font-weight: 800; color: #2E6B4F; margin-bottom: 16rpx; }
.spot { padding: 20rpx 0; border-bottom: 2rpx solid #F0F4F0; }
.spot:last-child { border-bottom: none; }
.spot-rest { background: #FFF7ED; border-radius: 16rpx; padding: 20rpx 24rpx; margin: 12rpx 0; }
.spot-meal { background: #F0F7F3; border-radius: 16rpx; padding: 20rpx 24rpx; margin: 12rpx 0; }
.spot-restday { background: #F4FAF6; border: 2rpx dashed #CFE0D4; border-radius: 16rpx; padding: 20rpx 24rpx; margin: 12rpx 0; }
.spot-name { font-size: 1.05em; font-weight: 700; color: #2B3440; }
.spot-meta { font-size: 0.85em; color: #7C8B83; margin: 8rpx 0; }
.spot-desc { font-size: 0.92em; color: #33413B; margin: 8rpx 0; }
.risk-item { font-size: 0.92em; color: #374151; margin: 10rpx 0; }
.tip-group { margin-top: 20rpx; }
.tip-group-title { font-size: 0.95em; font-weight: 700; color: #2E6B4F; margin-bottom: 6rpx; }
.adjust-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.adjust-btn {
  flex: 1; min-width: 40%;
  text-align: center; padding: 20rpx 0;
  background: #E9F4EE; color: #2E6B4F;
  border-radius: 16rpx; font-size: 1em; font-weight: 700;
}
.adjust-btn:active { background: #CFE0D4; }
.big-btn.done { background: #9AA5B1; }
.center-tip { text-align: center; margin: 12rpx 32rpx; }
