.page { padding-bottom: 60rpx; }
.page-head { font-size: 1.2em; font-weight: 800; color: #2E6B4F; margin: 32rpx 32rpx 8rpx; }
.plan-item { position: relative; }
.plan-title { font-size: 1.1em; font-weight: 700; color: #2B3440; }
.plan-meta { font-size: 0.9em; color: #6B7280; margin-top: 8rpx; }
.plan-time { font-size: 0.8em; color: #9AA5B1; margin-top: 8rpx; }
.del-btn {
  position: absolute; right: 28rpx; top: 28rpx;
  padding: 10rpx 22rpx; border: 3rpx solid #FCA5A5; color: #B91C1C;
  border-radius: 12rpx; font-size: 0.85em;
}
.center-tip { text-align: center; margin: 24rpx; }
