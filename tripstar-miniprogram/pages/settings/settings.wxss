/* pages/settings/settings.wxss */
.settings-container {
  min-height: 100vh;
  padding: 32rpx 24rpx 80rpx;
}

.settings-title {
  font-size: 40rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
  background: linear-gradient(135deg, #ffb347 0%, #ff6b6b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 28rpx;
}

.settings-form {
  display: flex;
  flex-direction: column;
}

.field-item {
  margin-bottom: 24rpx;
}

.section-divider {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.06);
  margin: 8rpx 0 28rpx;
}

.settings-tip {
  margin-top: 24rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.3);
  font-size: 22rpx;
}
