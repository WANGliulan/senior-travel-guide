/* pages/history/history.wxss */
.history-container {
  min-height: 100vh;
  padding: 32rpx 24rpx 80rpx;
}

.history-header {
  margin-bottom: 28rpx;
}

.history-title {
  font-size: 40rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
  background: linear-gradient(135deg, #ffb347 0%, #ff6b6b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  padding: 28rpx;
  border-radius: 20rpx;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.item-city {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
}

.item-days {
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 179, 71, 0.12);
  border: 1px solid rgba(255, 179, 71, 0.25);
  color: #ffd699;
  font-size: 24rpx;
}

.item-dates {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 12rpx;
}

.item-suggestion {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-updated {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

.empty-create-btn {
  margin-top: 32rpx;
}
