/* pages/index/index.wxss */
.home-container {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  position: relative;
  overflow: hidden;
}

/* 语言切换 */
.lang-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 8rpx;
}

.lang-options {
  display: flex;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
}

.lang-option {
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.lang-option.active {
  color: #ffd699;
  background: rgba(255, 179, 71, 0.14);
}

/* Hero */
.hero-section {
  text-align: center;
  padding: 40rpx 0 48rpx;
}

.hero-badge {
  display: inline-block;
  background: rgba(255, 179, 71, 0.08);
  border: 1px solid rgba(255, 179, 71, 0.2);
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  color: #ffd699;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 32rpx;
  letter-spacing: 0.05em;
}

.hero-title {
  margin-bottom: 24rpx;
}

.title-line {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #ffb347 0%, #ff6b6b 50%, #c084fc 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 400;
  letter-spacing: 0.02em;
  line-height: 1.6;
}

/* 表单 */
.glass-card {
  margin-top: 8rpx;
}

.step-section {
  margin-bottom: 48rpx;
}

.fields-2 {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.field-item {
  flex: 1;
  margin-bottom: 24rpx;
}

.picker-value {
  line-height: 86rpx;
  display: flex;
  align-items: center;
}

.picker-placeholder {
  color: rgba(255, 255, 255, 0.25);
}

/* 天数芯片 */
.days-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #ffb347 0%, #ff6b6b 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 179, 71, 0.3);
  margin-top: 8rpx;
}

.days-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.days-text {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
}

/* 兴趣标签 */
.interest-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.interest-card {
  width: calc((100% - 32rpx) / 3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.interest-card.active {
  border-color: #ffb347;
  background: rgba(255, 179, 71, 0.12);
  box-shadow: 0 0 24rpx rgba(255, 179, 71, 0.15);
}

.interest-name {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
}

.interest-card.active .interest-name {
  color: #ffd699;
}

/* 进度条 */
.progress-section {
  margin-top: 32rpx;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffb347, #ff6b6b, #c084fc);
  border-radius: 6rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 20rpx rgba(255, 179, 71, 0.4);
}

.progress-text {
  margin-top: 20rpx;
  text-align: center;
  color: #ffd699;
  font-size: 28rpx;
  font-weight: 500;
}

/* 历史计划 */
.history-section {
  margin-top: 56rpx;
}

.refresh-btn {
  font-size: 24rpx;
  padding: 0 8rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  padding: 28rpx;
  border-radius: 20rpx;
}

.history-city {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.history-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.history-days {
  color: #ffd699;
}

.history-suggestion {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
