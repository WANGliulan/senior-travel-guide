/* pages/result/result.wxss */
.result-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部分区切换 */
.top-switch-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(10, 10, 15, 0.92);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 16rpx 0;
}

.switch-scroll {
  white-space: nowrap;
}

.switch-menu {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}

.switch-item {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: all 0.3s;
}

.switch-item.active {
  color: #ffd699;
  background: rgba(255, 179, 71, 0.12);
  border-color: rgba(255, 179, 71, 0.25);
}

.result-body {
  flex: 1;
  height: calc(100vh - 140rpx);
}

.section-body {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* ===== 概览 ===== */
.overview-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.overview-card {
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
}

.overview-image-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.overview-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #1a262f;
}

.overview-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}

.badge-number {
  color: #ffd699;
  font-size: 22rpx;
  font-weight: 700;
}

.overview-price {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(255, 87, 34, 0.85);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.overview-info {
  flex: 1;
  min-width: 0;
}

.overview-name {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 8rpx;
}

.overview-address {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-duration {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 8rpx;
}

.overview-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.overview-day-tag {
  margin-top: 12rpx;
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 179, 71, 0.1);
  border: 1px solid rgba(255, 179, 71, 0.2);
  color: #ffd699;
  font-size: 24rpx;
}

.overview-meta {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.overview-date {
  color: #ffd5c6;
  font-weight: 700;
  font-size: 26rpx;
}

.overview-planid {
  color: rgba(255, 255, 255, 0.3);
  font-size: 22rpx;
}

.overview-suggestion {
  margin-top: 20rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

/* ===== 地图 ===== */
.map-toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.trip-map {
  width: 100%;
  height: 700rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.map-empty {
  text-align: center;
  color: rgba(255, 255, 255, 0.4);
  padding: 60rpx 0;
}

/* 返回顶部 */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 179, 71, 0.15);
  border: 1px solid rgba(255, 179, 71, 0.3);
  color: #ffd699;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

/* 空状态 */
.empty-state-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.empty-back-btn {
  margin-top: 32rpx;
}
