/* components/weather-panel/weather-panel.wxss */
.weather-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 主卡片 */
.weather-hero {
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  color: #fff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
}

.hero-top {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 32rpx;
}

.hero-weekday {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.hero-date {
  font-size: 28rpx;
  opacity: 0.85;
}

.hero-location {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.hero-weather {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weather-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.weather-icon .icon-symbol {
  font-size: 120rpx;
  line-height: 1;
}

.hero-temp {
  font-size: 108rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-top: 8rpx;
}

.hero-desc {
  font-size: 34rpx;
  font-weight: 600;
  opacity: 0.92;
}

/* 周列表 */
.weather-week {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx 0;
}

.week-scroll {
  white-space: nowrap;
}

.week-list {
  display: inline-flex;
  gap: 8rpx;
  padding: 0 16rpx;
}

.week-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.week-item.active {
  background: rgba(255, 179, 71, 0.12);
  border: 1px solid rgba(255, 179, 71, 0.2);
}

.week-icon .icon-symbol-small {
  font-size: 48rpx;
}

.week-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.week-item.active .week-name {
  color: #ffd699;
}

.week-temp {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

/* 详情 */
.weather-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.detail-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}
