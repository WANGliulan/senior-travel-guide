/* components/knowledge-graph/knowledge-graph.wxss */
.kg-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.kg-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffd699;
}

.kg-canvas {
  width: 100%;
  height: 700rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
}

.kg-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.kg-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 30rpx;
}

.kg-legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.kg-legend-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}
